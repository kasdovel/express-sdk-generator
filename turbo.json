{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen"]
    },
    "test": {
      "dependsOn": ["^build", "gen"]
    },
    "lint": {
      "dependsOn": ["^build", "gen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "gen": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json", "openapi.yaml", "docs/**", "sdk/**"]
    }
  }
}
